[Unit]
Description=Wise Pi API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/wise-pi/app
Environment="PATH=/home/pi/wise-pi/app/.venv/bin"
ExecStart=/home/pi/wise-pi/app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
User=steve

[Install]
WantedBy=multi-user.target
