[Unit]
Description=Wise Pi API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/steve/wise-pi/app
Environment="PATH=/home/steve/wise-pi/app/.venv/bin"
EnvironmentFile=-/home/steve/wise-pi/app/.env
ExecStart=/home/steve/wise-pi/app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
User=steve
Group=steve

[Install]
WantedBy=multi-user.target
